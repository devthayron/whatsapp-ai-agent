# Segurança
SECRET_KEY=your_secret_key_here          # python -c "import secrets; print(secrets.token_urlsafe(48))"
LOG_LEVEL=INFO

# Banco e cache
DATABASE_URL=postgresql+psycopg://chatbot:SUA_SENHA@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

# IA
OPENAI_API_KEY=sua_chave
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-nano

# WhatsApp Cloud API (Meta)
META_ACCESS_TOKEN=token_permanente_do_system_user
META_PHONE_NUMBER_ID=id_do_numero_no_painel
META_APP_SECRET=o_app_secret_do_painel
META_VERIFY_TOKEN=o_token_que_voce_escolheu

# Debounce
DEBOUNCE_SECONDS=7
DEBOUNCE_RETRY_SECONDS=15
DEBOUNCE_MAX_ATTEMPTS=3
